{
  "name": "cmc-web",
  "version": "1.0.0",
  "description": "Portal documental de CMC",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.2",
    "next": "^16.4.6",
    "nodemailer": "^7.0.11",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "private": true
}

# ── Base de datos ──────────────────────────────────────────────
# Local: SQLite en un fichero. Producción: Postgres en un servidor de la UE.
DATABASE_URL=file:./cmc.db
# DATABASE_URL=postgres://usuario:clave@servidor-ue:5432/cmc
# DATABASE_SSL=false   # solo si el Postgres no usa TLS

# Cadena larga y aleatoria (openssl rand -hex 32). También cifra los secretos del doble factor:
# si se cambia, los usuarios tendrán que volver a activar el doble factor.
PAYLOAD_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# Dirección pública del portal (enlaces de los correos, OAuth del servidor MCP).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Seguridad ─────────────────────────────────────────────────
# El doble factor es obligatorio para los super administradores. Se puede relajar (en producción, solo temporalmente):
# CMC_2FA_SUPERADMIN=opcional

# ── Correo transaccional (remitente del dominio de CMC) ────────
# Sin SMTP_HOST los correos se escriben en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=avisos@cmc.es
EMAIL_FROM_NAME=CMC · Portal documental
EMAIL_REPLY_TO=
# Secreto del webhook de eventos del proveedor (entregado, abierto, rebotado): /api/correos/eventos?secreto=…
EMAIL_WEBHOOK_SECRET=

# ── Archivos en Supabase Storage (protocolo S3) ────────────────
# Sin las dos claves los archivos se guardan en ./uploads.
# Las claves se crean en el proyecto: Storage → S3 Access Keys.
S3_BUCKET=documentos
S3_REGION=eu-west-1
S3_ENDPOINT=https://TU_PROYECTO.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# UPLOADS_DIR=./uploads

# ── Datos iniciales (npm run seed) ─────────────────────────────
# SEED_ADMIN_EMAIL=admin@cmc.es
# SEED_PASSWORD=
# SEED_SIN_DEMO=1
